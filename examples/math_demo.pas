say "=== PasLang Phase 2: Mathematics & Logic Demo ==="

let a = 20
let b = 6

let sum = add a b
let diff = sub a b
let prod = mul a b
let quotient = div a b
let remainder = mod a b
let power = pow 2 10
let root = sqrt 144

say "Sum of 20 + 6:"
say sum

say "Product of 20 * 6:"
say prod

say "Remainder of 20 % 6:"
say remainder

say "Power of 2^10:"
say power

say "Square root of 144:"
say root

say "=== Conditionals & Comparisons ==="

let age = 25

if age >= 18:
    say "Adult Access Granted"
else:
    say "Minor Access Restricted"

say "=== Repeat Loop Demo ==="

repeat 3:
    say "PasLang Loop Execution"
